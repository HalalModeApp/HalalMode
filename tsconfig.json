{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "// exclude": "Edge Functions run on Deno, not React Native — they are typechecked by `supabase functions` with its own config.",
  "exclude": ["node_modules", "supabase/functions", "tests", ".test-build"]
}
